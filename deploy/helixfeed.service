[Unit]
Description=HelixFeed market data ingestion daemon
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_USER
WorkingDirectory=REPLACE_WITH_PATH/HelixFeed
EnvironmentFile=/home/dakotah/secrets/helixfeed.env
ExecStart=REPLACE_WITH_PATH/HelixFeed/target/release/helix_feed
ExecStartPre=/bin/ln -sf /home/dakotah/secrets/helix_config.yml /home/dakotah/actions-runner/_work/HelixFeed/HelixFeed/helix_config.yml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
